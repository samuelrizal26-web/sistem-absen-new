{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "true",
    "nixpacksPlan": {
      "providers": ["python"],
      "phases": {
        "install": {
          "cmds": ["pip install -r requirements-minimal.txt"]
        }
      }
    }
  },
  "deploy": {
    "startCommand": "uvicorn server:app --host 0.0.0.0 --port $PORT",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "environments": {
    "staging": {
      "build": {
        "builder": "NIXPACKS",
        "buildCommand": "true",
        "nixpacksPlan": {
          "providers": ["python"],
          "phases": {
            "install": {
              "cmds": ["pip install -r requirements-minimal.txt"]
            }
          }
        }
      }
    }
  }
}
